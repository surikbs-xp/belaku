# Belaku TradeBot Environment Variables

# Zerodha API Configuration
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here
ZERODHA_ACCESS_TOKEN=your_zerodha_access_token_here

# Trading Configuration
TRADING_MODE=paper  # paper, live
MAX_POSITION_SIZE=100000
STOP_LOSS_PERCENTAGE=0.02
TAKE_PROFIT_PERCENTAGE=0.05
MAX_DRAWDOWN=0.1
MAX_TRADES_PER_DAY=100

# Data Configuration
DATA_COLLECTION_INTERVAL=1.0
CACHE_SIZE=10000
HISTORICAL_DAYS=30

# Risk Management
RISK_PER_TRADE=0.01
MAX_CONCURRENT_TRADES=10
TRADE_COOLDOWN_SECONDS=300

# GiftNifty Configuration
GIFTNIFTY_MIN_SIGNAL_STRENGTH=0.7
GIFTNIFTY_MIN_CONFIDENCE=0.8
GIFTNIFTY_MAX_SIGNALS_PER_HOUR=10
GIFTNIFTY_COOLDOWN_PERIOD=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=tradebot.log

# Monitoring
PROMETHEUS_PORT=8000
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Database (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/tradebot
REDIS_URL=redis://localhost:6379/0

# Exchange Configuration
EXCHANGE_TIMEOUT=30
EXCHANGE_RETRY_COUNT=3
EXCHANGE_RETRY_DELAY=1.0

# Strategy Configuration
STRATEGY_ENABLED=true
STRATEGY_PARAMETERS={"param1": "value1", "param2": "value2"}

# Monitoring and Alerts
ALERT_EMAILS=email1@example.com,email2@example.com
ALERT_PHONE_NUMBERS=+1234567890,+0987654321

# Security
API_KEY_ROTATION_DAYS=90
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5