//@version=6
indicator("SuperTrend Weighted by Divergence + Triple ST Strategy", overlay=true, max_lines_count=500, max_labels_count=500)

// =====================================================
// 1. ORIGINAL INPUT SETTINGS
// =====================================================

atrLen         = input.int(10, "ATR Length", minval=1)
baseFactor     = input.float(3.0, "Base ATR Multiplier", minval=0.1, step=0.1)
pivotLength    = input.int(2, "Pivot Length (Left/Right)", minval=1)

divSensitivity = input.float(
     0.3,
     "Divergence Sensitivity",
     minval=0.0,
     maxval=1.0,
     step=0.01,
     tooltip="0.0 = No divergence influence\n1.0 = Maximum ATR multiplier reduction"
)

colorBarsEnabled = input.bool(true, "Color bars by trend", group="Color Settings")

upColor   = input.color(color.rgb(6, 162, 47), "Uptrend Color (Bullish)")
downColor = input.color(color.rgb(207, 23, 23), "Downtrend Color (Bearish)")

// =====================================================
// 2. STRATEGY SETTINGS
// =====================================================

showStrategyST = input.bool(true, "Show Triple SuperTrend Lines", group="Strategy Settings")
showEMA        = input.bool(true, "Show EMA 200", group="Strategy Settings")
showSignals    = input.bool(true, "Show Strategy BUY/SELL Labels", group="Strategy Settings")
showDiagnostics = input.bool(false, "Show Individual Condition Markers", group="Strategy Settings")

rsiLength = input.int(14, "RSI Length", minval=1, group="Strategy Settings")
tsvLength = input.int(13, "TSV Length", minval=1, group="Strategy Settings")
emaLength = input.int(200, "EMA Length", minval=1, group="Strategy Settings")

// =====================================================
// 3. ORIGINAL FIXED PARAMETERS
// =====================================================

confirmBars         = 1
len2                = 6
smoothLen2          = 7
calculateDivergence = true
showLine            = true
fillShade           = true
divBars             = 200

// =====================================================
// 4. ORIGINAL CPO OSCILLATOR FUNCTION
// =====================================================

calcCPO(_len, _smooth) =>
    body      = math.abs(close - open)
    avgBody   = ta.sma(body, _len)
    direction = close > open ? 1.0 : close < open ? -1.0 : 0.0
    weight    = avgBody != 0 ? body / avgBody : 1.0
    contrib   = direction * weight
    rolling   = 0.0

    for i = 0 to _len - 1
        rolling += contrib[i]

    norm = rolling / (_len * 2) * 100
    ta.ema(norm, _smooth)

osc = calcCPO(len2, smoothLen2)

// =====================================================
// 5. ORIGINAL DIVERGENCE CALCULATION
// =====================================================

lookbackRight = pivotLength
lookbackLeft  = pivotLength

pivotHighOsc = ta.pivothigh(osc, lookbackLeft, lookbackRight)
pivotLowOsc  = ta.pivotlow(osc, lookbackLeft, lookbackRight)

var bool bullCond = false
var bool bearCond = false

oscLbr = osc[lookbackRight]

if calculateDivergence
    plFound = not na(pivotLowOsc)
    oscHL   = oscLbr > ta.valuewhen(plFound, oscLbr, 1)
    priceLL = low[lookbackRight] < ta.valuewhen(plFound, low[lookbackRight], 1)
    bullCond := priceLL and oscHL and plFound

    phFound = not na(pivotHighOsc)
    oscLH   = oscLbr < ta.valuewhen(phFound, oscLbr, 1)
    priceHH = high[lookbackRight] > ta.valuewhen(phFound, high[lookbackRight], 1)
    bearCond := priceHH and oscLH and phFound

bullDiv = bullCond
bearDiv = bearCond

// =====================================================
// 6. ORIGINAL CUSTOM SUPERTREND
// =====================================================

atr = ta.atr(atrLen)
hl2 = (high + low) / 2

var float trailLong  = na
var float trailShort = na
var int regime       = 0

trailLong  := na(trailLong) ? hl2 : trailLong
trailShort := na(trailShort) ? hl2 : trailShort

var int originalBullCount = 0
var int originalBearCount = 0

originalBullCount := close > trailShort ? originalBullCount + 1 : 0
originalBearCount := close < trailLong ? originalBearCount + 1 : 0

// Trend flip logic

nextRegime = regime

if regime == 0
    if originalBullCount >= confirmBars
        nextRegime := 1
    else if originalBearCount >= confirmBars
        nextRegime := -1
else if regime == 1 and originalBearCount >= confirmBars
    nextRegime := -1
else if regime == -1 and originalBullCount >= confirmBars
    nextRegime := 1

flipHappens = nextRegime != regime

// =====================================================
// 7. ORIGINAL DIVERGENCE IMPACT LOGIC
// =====================================================

var int divAge  = 9999
var int divType = 0

if bullDiv
    divAge  := 0
    divType := 1
else if bearDiv
    divAge  := 0
    divType := -1
else if flipHappens
    divAge  := 9999
    divType := 0
else
    divAge += 1

divActive = divAge <= divBars and divType == -nextRegime

factorAdjusted = baseFactor

if divActive and not flipHappens
    factorAdjusted := baseFactor * (1 - divSensitivity)

// =====================================================
// 8. ORIGINAL SUPERTREND BANDS AND TRAILS
// =====================================================

bandTop = hl2 + factorAdjusted * atr
bandBot = hl2 - factorAdjusted * atr

if nextRegime == 1
    trailLong  := math.max(bandBot, nz(trailLong[1], bandBot))
    trailShort := bandTop
else if nextRegime == -1
    trailShort := math.min(bandTop, nz(trailShort[1], bandTop))
    trailLong  := bandBot
else
    trailLong  := bandBot
    trailShort := bandTop

regime := nextRegime

// =====================================================
// 9. ORIGINAL VISUALIZATION
// =====================================================

plotLine = flipHappens ? na : (regime == 1 ? trailLong : trailShort)

pLine = plot(
     plotLine,
     color=showLine ? color.new(regime == 1 ? upColor : downColor, 60) : na,
     linewidth=1,
     style=plot.style_linebr
)

pCenter = plot(hl2, display=display.none)

fill(
     pLine,
     pCenter,
     plotLine,
     hl2,
     fillShade ? color.new(regime == 1 ? upColor : downColor, 85) : na,
     fillShade ? color.new(regime == 1 ? upColor : downColor, 95) : na
)

// Original trend-flip labels

if flipHappens
    label.new(
         bar_index,
         regime == 1 ? low - atr * 0.5 : high + atr * 0.5,
         regime == 1 ? "ST Buy" : "ST Sell",
         color=color.new(regime == 1 ? upColor : downColor, 40),
         style=regime == 1 ? label.style_label_up : label.style_label_down,
         textcolor=color.white,
         size=size.small
    )

// Original bar colouring

barcolor(colorBarsEnabled ? (regime == 1 ? upColor : downColor) : na)

// Original divergence markers

plotshape(bullDiv, title="Bullish Divergence", location=location.belowbar, color=upColor, style=shape.circle, size=size.tiny)
plotshape(bearDiv, title="Bearish Divergence", location=location.abovebar, color=downColor, style=shape.circle, size=size.tiny)

// =====================================================
// 10. TRIPLE SUPERTREND STRATEGY
// =====================================================

// SuperTrend 1: ATR 10, Multiplier 1
[st1, dir1] = ta.supertrend(1.0, 10)

// SuperTrend 2: ATR 11, Multiplier 2
[st2, dir2] = ta.supertrend(2.0, 11)

// SuperTrend 3: ATR 12, Multiplier 3
[st3, dir3] = ta.supertrend(3.0, 12)

// TradingView direction:
// Negative = Bullish
// Positive = Bearish

st1Bull = dir1 < 0
st2Bull = dir2 < 0
st3Bull = dir3 < 0

st1Bear = dir1 > 0
st2Bear = dir2 > 0
st3Bear = dir3 > 0

// Count SuperTrend directions

strategyBullCount = (st1Bull ? 1 : 0) + (st2Bull ? 1 : 0) + (st3Bull ? 1 : 0)
strategyBearCount = (st1Bear ? 1 : 0) + (st2Bear ? 1 : 0) + (st3Bear ? 1 : 0)

// =====================================================
// 11. EMA, RSI AND TSV
// =====================================================

ema200 = ta.ema(close, emaLength)
rsiValue = ta.rsi(close, rsiLength)

// TSV approximation:
// Rolling sum of price change multiplied by volume.
// Replace this with your original TSV formula if different.

tsvValue = math.sum((close - close[1]) * volume, tsvLength)

// =====================================================
// 12. BUY CONDITIONS
// =====================================================

buyEMA = close > ema200
buyST  = strategyBullCount >= 2
buyRSI = rsiValue < 20
buyTSV = tsvValue > 0

longCondition = buyEMA and buyST and buyRSI and buyTSV

// =====================================================
// 13. SELL CONDITIONS
// =====================================================

sellEMA = close < ema200
sellST  = strategyBearCount >= 2
sellRSI = rsiValue > 80
sellTSV = tsvValue < 0

shortCondition = sellEMA and sellST and sellRSI and sellTSV

// =====================================================
// 14. STRATEGY SIGNALS
// =====================================================

// Signal on the first confirmed candle where all conditions
// become true. This prevents repeated labels on every candle.

buySignal = barstate.isconfirmed and longCondition and not longCondition[1]
sellSignal = barstate.isconfirmed and shortCondition and not shortCondition[1]

// =====================================================
// 15. PLOT TRIPLE SUPERTREND AND EMA
// =====================================================

plot(showStrategyST ? st1 : na, title="Strategy ST1 (10,1)", color=color.new(st1Bull ? color.lime : color.red, 65), linewidth=1, style=plot.style_linebr)

plot(showStrategyST ? st2 : na, title="Strategy ST2 (11,2)", color=color.new(st2Bull ? color.green : color.maroon, 65), linewidth=1, style=plot.style_linebr)

plot(showStrategyST ? st3 : na, title="Strategy ST3 (12,3)", color=color.new(st3Bull ? color.aqua : color.orange, 65), linewidth=1, style=plot.style_linebr)

plot(showEMA ? ema200 : na, title="EMA 200", color=color.new(color.yellow, 35), linewidth=2)

// =====================================================
// 16. STRATEGY BUY / SELL LABELS
// =====================================================

plotshape(
     showSignals and buySignal,
     title="Strategy BUY",
     text="BUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white,
     size=size.normal
)

plotshape(
     showSignals and sellSignal,
     title="Strategy SELL",
     text="SELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.normal
)

// =====================================================
// 17. OPTIONAL DIAGNOSTIC MARKERS
// =====================================================

// BUY conditions:
// Blue = Price above EMA
// Green = 2 or more bullish SuperTrends
// Yellow = RSI below 20
// Purple = TSV positive

plotshape(showDiagnostics and buyEMA, title="BUY EMA OK", style=shape.circle, location=location.bottom, color=color.blue, size=size.tiny)

plotshape(showDiagnostics and buyST, title="BUY ST OK", style=shape.circle, location=location.bottom, color=color.green, size=size.tiny)

plotshape(showDiagnostics and buyRSI, title="BUY RSI OK", style=shape.circle, location=location.bottom, color=color.yellow, size=size.tiny)

plotshape(showDiagnostics and buyTSV, title="BUY TSV OK", style=shape.circle, location=location.bottom, color=color.purple, size=size.tiny)

// SELL conditions:
// Orange = Price below EMA
// Red = 2 or more bearish SuperTrends
// Yellow = RSI above 80
// Purple = TSV negative

plotshape(showDiagnostics and sellEMA, title="SELL EMA OK", style=shape.diamond, location=location.top, color=color.orange, size=size.tiny)

plotshape(showDiagnostics and sellST, title="SELL ST OK", style=shape.diamond, location=location.top, color=color.red, size=size.tiny)

plotshape(showDiagnostics and sellRSI, title="SELL RSI OK", style=shape.diamond, location=location.top, color=color.yellow, size=size.tiny)

plotshape(showDiagnostics and sellTSV, title="SELL TSV OK", style=shape.diamond, location=location.top, color=color.purple, size=size.tiny)

// =====================================================
// 18. ALERTS
// =====================================================

// Original custom SuperTrend alerts

alertcondition(flipHappens and regime == 1, title="Original SuperTrend Buy", message="Original SuperTrend Buy Signal")

alertcondition(flipHappens and regime == -1, title="Original SuperTrend Sell", message="Original SuperTrend Sell Signal")

alertcondition(bullDiv, title="Bullish Divergence", message="Bullish Divergence Detected")

alertcondition(bearDiv, title="Bearish Divergence", message="Bearish Divergence Detected")

// New strategy alerts

alertcondition(buySignal, title="Strategy BUY Alert", message="Triple SuperTrend Strategy BUY Signal")

alertcondition(sellSignal, title="Strategy SELL Alert", message="Triple SuperTrend Strategy SELL Signal")
