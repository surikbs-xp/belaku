.DS_Store
__pycache__
.pytest_cache/
.venv/
.env

# Real credentials. Note `*.env` does NOT match `.env.example`, so the
# template stays committable while actual secrets stay out of git.
*.env*s
.env.*
!.env.example
!bot/.env.example

# Runtime state
paper_trading.db
paper_trading.db-shm
paper_trading.db-wal
*.sqlite
*.sqlite3
bot/logs/
bot/data/

# Database backups. These hold the full trading record - positions, orders,
# trades, PnL - and belong off-box, not in a public repository.
backups/
*.db.bak
