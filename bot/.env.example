# ---------------------------------------------------------------------------
# Belaku - configuration template
#
# Copy to .env and fill in. Every value is optional: the bot boots in PAPER
# mode with no credentials at all. See docs/configuration for the full
# reference, and docs/production before trading live.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
EXECUTION_MODE=PAPER            # PAPER | LIVE

# ---------------------------------------------------------------------------
# Zerodha Kite Connect
# Create an app at https://developers.kite.trade. The access token expires at
# ~06:00 IST every day, so it must be refreshed each morning - the dashboard's
# Connect button does it. Register this Redirect URL in the Kite console.
# ---------------------------------------------------------------------------
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:9000/zerodha/callback

# ---------------------------------------------------------------------------
# Dashboard / API bind
# There is no inbound webhook: the bot pulls market data itself. These only
# control where the dashboard and JSON API listen.
# ---------------------------------------------------------------------------
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=9000
# Shown as the browser tab title and the dashboard header.
BOT_NAME=Belaku
# Host header allow-list and extra cross-origin origins, comma separated.
# Same-origin (127.0.0.1/localhost) is always allowed, so these are only needed
# for a reverse proxy or a hosted frontend.
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
ALLOWED_ORIGINS=
# Set 1 to serve /docs and /openapi.json. Off by default: the schema enumerates
# every control endpoint, including the one that squares off live positions.
ENABLE_API_DOCS=0

# ---------------------------------------------------------------------------
# Dashboard authentication
# The dashboard can arm LIVE trading and square off positions, so it is
# password protected. Leaving this empty is only safe on a machine nobody else
# can reach. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=
# Optional. Pins the session signing key so logins survive a restart. Empty
# means a fresh random key per process, which signs everyone out on restart.
DASHBOARD_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
# Webhook that receives JSON alerts when the bot is up but not working: a stale
# feed, a risk breach, a paused strategy. Works with Slack, Discord or ntfy.
# Empty means alerts are only logged and shown on the dashboard.
ALERT_WEBHOOK_URL=
# How often the watchdog checks trading health, in seconds.
WATCHDOG_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# Sizing / risk
# ---------------------------------------------------------------------------
DEFAULT_LOTS=1
NIFTY_LOT_SIZE=65
VIRTUAL_BALANCE=200000
MAX_OPEN_LOTS=4
LOT_MARGIN=150000
# --- Risk limits -----------------------------------------------------------
# The strategy has no stop-loss of its own: it exits on an opposite signal or a
# manual square-off, so between those a position is unbounded. This is the only
# limit that bounds it. 0 disables the check.
#
# Close a position once it is this many index points against entry. For Nifty a
# point is Rs 1 per unit, so 65 units x 100 points = Rs 6,500.
STOP_LOSS_POINTS=0
SLIPPAGE_TICKS=1
TICK_SIZE=0.05
PRODUCT=NRML                    # NRML (carry-forward) | MIS (intraday)
ORDER_TYPE=MARKET

# ---------------------------------------------------------------------------
# Strategy (st.pine)
# The engine evaluates SuperTrend and PSAR on GIFT Nifty candles. These mirror
# the Pine inputs - change only if you change Pine.
# ---------------------------------------------------------------------------
# Triple SuperTrend as atr_length:multiplier pairs, comma separated.
# Each pair is one vote; STRATEGY_ST_MIN_AGREE of them must agree.
STRATEGY_SUPERTRENDS=11:1,12:2,13:3
STRATEGY_ST_MIN_AGREE=2            # of the 3 SuperTrends that must agree
STRATEGY_PSAR_START=0.02
STRATEGY_PSAR_INCREMENT=0.02
STRATEGY_PSAR_MAXIMUM=0.2

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# The engine loads GIFT Nifty candles from Kite history (the source of truth)
# and falls back to building them from live NSEIX ticks. This interval must
# match the timeframe the strategy was tuned on.
GIFT_CANDLE_INTERVAL=15minute
# How often the mark loop updates PnL/equity and the engine checks for a new bar.
ENGINE_INTERVAL_SECONDS=5
QUOTE_POLL_SECONDS=5
# How often the Kite instrument dump is re-fetched, in seconds.
INSTRUMENT_REFRESH_SECONDS=3600
HTTP_TIMEOUT_SECONDS=4

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DB_PATH=paper_trading.db
# Defaults: bot/logs/bot.log and bot/data/nse_holidays.json. In Docker these
# must point at /data, because the image is read-only.
# LOG_FILE=logs/bot.log
# HOLIDAY_CACHE_PATH=data/nse_holidays.json
# Minimum level written, and the floor the Logs tab can query.
LOG_LEVEL=INFO
# Set 1 to log every HTTP request. Noisy; for debugging only.
UVICORN_ACCESS_LOG=0

# ---------------------------------------------------------------------------
# Testing escape hatches - leave these alone in normal operation
# ---------------------------------------------------------------------------
# Set 1 to allow orders outside market hours. This bypasses a real safety check.
# TRADING_ALLOW_OFF_HOURS=0
