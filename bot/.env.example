# ---------------------------------------------------------------------------
# Belaku - configuration template
#
# Copy to .env and fill in. Every value is optional: the bot boots in PAPER
# mode with no credentials at all. See docs/configuration for the full
# reference, and docs/production before trading live.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
EXECUTION_MODE=PAPER            # PAPER | LIVE

# ---------------------------------------------------------------------------
# Zerodha Kite Connect
# Create an app at https://developers.kite.trade. The access token expires at
# ~06:00 IST every day, so it must be refreshed each morning - the dashboard's
# Connect button does it. Register this Redirect URL in the Kite console.
# ---------------------------------------------------------------------------
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:9000/zerodha/callback

# Headless login (optional). Kite has no token API, so an unattended deployment
# has to perform the browser flow itself. With these three set the bot logs in
# on startup and again whenever the token is rejected, which is what makes a
# stateless container viable - the token never has to survive a restart.
#
# Requires TOTP-based 2FA. An account that approves logins through the Kite
# mobile app cannot be logged in headlessly. The TOTP secret is a second factor:
# treat it like the password, and prefer a dedicated account over your primary.
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
# How often the token keeper checks that the token still works.
TOKEN_CHECK_SECONDS=300

# ---------------------------------------------------------------------------
# Dashboard / API bind
# There is no inbound webhook: the bot pulls market data itself. These only
# control where the dashboard and JSON API listen.
# ---------------------------------------------------------------------------
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=9000
# Shown as the browser tab title and the dashboard header.
BOT_NAME=Belaku
# Host header allow-list and extra cross-origin origins, comma separated.
# Same-origin (127.0.0.1/localhost) is always allowed, so these are only needed
# for a reverse proxy or a hosted frontend.
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
ALLOWED_ORIGINS=
# Set 1 to serve /docs and /openapi.json. Off by default: the schema enumerates
# every control endpoint, including the one that squares off live positions.
ENABLE_API_DOCS=0

# ---------------------------------------------------------------------------
# Dashboard authentication
# The dashboard can arm LIVE trading and square off positions, so it is
# password protected. Leaving this empty is only safe on a machine nobody else
# can reach. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=
# Optional. Pins the session signing key so logins survive a restart. Empty
# means a fresh random key per process, which signs everyone out on restart.
DASHBOARD_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
# Where alerts go. Each service rejects a payload it does not recognise, so the
# channel must match the destination:
#
#   telegram  ALERT_TELEGRAM_BOT_TOKEN + ALERT_TELEGRAM_CHAT_ID
#   slack     ALERT_WEBHOOK_URL (incoming webhook)
#   discord   ALERT_WEBHOOK_URL (channel webhook)
#   ntfy      ALERT_WEBHOOK_URL (https://ntfy.sh/<your-topic>)
#   generic   ALERT_WEBHOOK_URL; receives the raw JSON payload
#
# Master switch. Off means nothing is sent at all, whatever ALERT_CHANNEL and the
# credentials below say: alerts are only logged and shown on the dashboard. Turn
# it on while testing the channel, then back off - the bot is noisy by design
# (every fill, every flip) and a phone is a poor place to read a session.
ALERT_ENABLED=0

# Where a message would go once enabled. Empty means only the dashboard.
ALERT_CHANNEL=telegram
ALERT_WEBHOOK_URL=

# Telegram: create a bot with @BotFather, then message it *from your own account*
# once and read the chat id. The id is the chat that talked to the bot, never the
# bot's own: `ALERT_TELEGRAM_CHAT_ID=belaku_bot` returns "chat not found" and the
# bot's own numeric id returns "the bot can't send messages to the bot".
# Run `scripts/telegram-setup.py --test` and it resolves and verifies this for you.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Send a message on start and stop, so a silent crash is distinguishable from a
# quiet market.
ALERT_ON_LIFECYCLE=1
# How often the watchdog checks trading health, in seconds.
WATCHDOG_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# Sizing / risk
# ---------------------------------------------------------------------------
DEFAULT_LOTS=1
NIFTY_LOT_SIZE=65
VIRTUAL_BALANCE=200000
MAX_OPEN_LOTS=4
LOT_MARGIN=150000

# Daily realised-loss circuit breaker, in rupees. Once the day's settled loss
# reaches this, new entries are refused in every book until the next session.
# It never flattens an open position - each position already carries its own
# protective stop. 0 disables the check.
MAX_DAILY_LOSS=0

# STOP_LOSS_POINTS, TRAILING_* and LARGE_CANDLE_* are no longer read. They are
# listed here only so an old .env is not a mystery: leaving them set is harmless,
# and they cannot arm a stop or suppress a signal. Per-strategy stops are
# configured with STRATEGY_<n>_STOP_LOSS / _TRAIL_* below.

SLIPPAGE_TICKS=1
TICK_SIZE=0.05
PRODUCT=NRML                    # NRML (carry-forward) | MIS (intraday)
ORDER_TYPE=MARKET

# ---------------------------------------------------------------------------
# Strategy (st.pine)
# The engine evaluates SuperTrend and PSAR on GIFT Nifty candles. These mirror
# the Pine inputs - change only if you change Pine.
# ---------------------------------------------------------------------------
# SuperTrend is fixed at 14-period ATR x 3 and is not configurable: a second
# instance would reintroduce the vote this strategy deliberately dropped.
STRATEGY_PSAR_START=0.02
STRATEGY_PSAR_INCREMENT=0.02
STRATEGY_PSAR_MAXIMUM=0.2

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# The engine loads GIFT Nifty candles from Kite history (the source of truth)
# and falls back to building them from live NSEIX ticks. This interval must
# match the timeframe the strategy was tuned on.
GIFT_CANDLE_INTERVAL=60minute

# ---------------------------------------------------------------------------
# Strategies - exactly two
# ---------------------------------------------------------------------------
# Two independent strategies, each with its own signal series, timeframe, stop
# and LIVE/PAPER mode. Both execute on the same NFO Nifty future, so they are NOT
# independent at the broker: Zerodha nets a long in one with a short in the other
# into a single position. The bot refuses opposing legs in one contract and
# shares MAX_OPEN_LOTS as a portfolio budget - see bot/portfolio.py. The two books
# need distinct IDs, or the ledger cannot tell their positions apart.
#
#   A  GIFT NIFTY 15m  ->  signal GIFT 15m,  execute NIFTY futures
#   B  NIFTY      60m  ->  signal NIFTY 60m, execute NIFTY futures
#
# SOURCE is the series a strategy reads: `gift` (NSEIX:GIFT NIFTY) or `nifty`
# (NSE:NIFTY 50). INTERVAL is its own timeframe; the two never share a series.
#
# -- Stops ------------------------------------------------------------------
# Every stop is measured on the *futures* execution price, never on the signal
# index. STOP_LOSS is the initial distance from the fill. The trail activates at
# TRAIL_AFTER points of open profit and then follows the best price at
# TRAIL_POINTS, switching to TRAIL_POINTS_AFTER once the wider band is reached.
# A stop only ever moves in the profitable direction and never widens.
#
#   A  GIFT 15m: 50-pt stop, 5-pt trail, 30-pt trail once +50
#   B  NIFTY 60m: 200-pt stop, 100-pt trail once +200
#
# STRATEGY_1_SOURCE=gift
# STRATEGY_1_ID=gift-15m
# STRATEGY_1_NAME=GIFT NIFTY 15m
# STRATEGY_1_INTERVAL=15minute
# STRATEGY_1_EXIT=flat
# STRATEGY_1_LOTS=1
# STRATEGY_1_ENABLED=1
# STRATEGY_1_LIVE=0
# STRATEGY_1_STOP_LOSS=50
# STRATEGY_1_TRAIL_POINTS=5
# STRATEGY_1_TRAIL_AFTER=50
# STRATEGY_1_TRAIL_POINTS_AFTER=30
#
# STRATEGY_2_SOURCE=nifty
# STRATEGY_2_ID=nifty-60m
# STRATEGY_2_NAME=NIFTY 60m
# STRATEGY_2_INTERVAL=60minute
# STRATEGY_2_EXIT=flip
# STRATEGY_2_LOTS=1
# STRATEGY_2_ENABLED=1
# STRATEGY_2_LIVE=0
# STRATEGY_2_STOP_LOSS=200
# STRATEGY_2_TRAIL_POINTS=100
# STRATEGY_2_TRAIL_AFTER=200
# STRATEGY_2_TRAIL_POINTS_AFTER=100
#
# STRATEGY_<n>_LIVE decides whether that book places real orders. Default 0,
# deliberately: an unset flag must never be what puts real money on a signal
# nobody considered funding. Each book has its own LIVE/PAPER switch on the
# dashboard, and the choice is persisted across restarts.
#
# Optional entry filters, both off by default.
#
# Measured over three years of NIFTY 60-minute bars (5,183 bars, 2023-11 to
# 2026-11), against an unfiltered baseline of 177 trades / 41.2% win /
# +Rs160,318:
#
#   ADX>10  177 trades  41.2%  +Rs160,646   (no change - the gate never fires)
#   ADX>12  177 trades  41.2%  +Rs163,259   (no change)
#   ADX>15  175 trades  41.1%   +Rs92,221   (worse)
#   ADX>18  165 trades  41.2%   -Rs19,762   (loses money)
#   ADX>20  157 trades  42.7%   -Rs75,057   (loses money)
#   ADX>25  120 trades  44.2%    -Rs7,270   (loses money)
#
# ADX raises the win rate slightly at high thresholds and destroys the net,
# because it removes the large winners along with the losers. It is monotonic:
# every step up costs money. Do not enable it expecting the win rate to pay for
# the trades it removes.
#
# MA50 is the only filter that helped: 87 trades / 51.7% / +Rs247,679. It is not
# on by default because its second half is negative (-Rs85,805), its bootstrap
# 95% CI on net/trade is [-Rs4,304, +Rs10,328] and includes zero, and its single
# biggest trade is 48% of gross profit. That is a fit, not an edge.
#
# STRATEGY_2_FILTER_ADX=15
# STRATEGY_2_FILTER_MA=50
# How often the mark loop updates PnL/equity and the engine checks for a new bar.
ENGINE_INTERVAL_SECONDS=5
QUOTE_POLL_SECONDS=5
# How often the Kite instrument dump is re-fetched, in seconds.
INSTRUMENT_REFRESH_SECONDS=3600
HTTP_TIMEOUT_SECONDS=4

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DB_PATH=paper_trading.db
# Defaults: bot/logs/bot.log and bot/data/nse_holidays.json. In Docker these
# must point at /data, because the image is read-only.
# LOG_FILE=logs/bot.log
# HOLIDAY_CACHE_PATH=data/nse_holidays.json
# Minimum level written, and the floor the Logs tab can query.
LOG_LEVEL=INFO
# Set 1 to log every HTTP request. Noisy; for debugging only.
UVICORN_ACCESS_LOG=0

# ---------------------------------------------------------------------------
# Testing escape hatches - leave these alone in normal operation
# ---------------------------------------------------------------------------
# Set 1 to allow orders outside market hours. This bypasses a real safety check.
# TRADING_ALLOW_OFF_HOURS=0
