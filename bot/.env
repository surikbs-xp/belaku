# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
EXECUTION_MODE=PAPER            # PAPER | LIVE

# ---------------------------------------------------------------------------
# Zerodha Kite Connect
# Create an app at https://developers.kite.trade and generate an access token
# for the trading day (tokens expire at ~06:00 IST every day).
# ---------------------------------------------------------------------------
KITE_API_KEY=vwajaizvyuaank3c
KITE_API_SECRET=xs1s3hypayv7q1010mx8pqtmgsrepjmv
KITE_ACCESS_TOKEN=xiiDqzcFsrUBCC53WaWpXfg6BvXaV0ZA
KITE_REDIRECT_URL=http://127.0.0.1:9000/zerodha/callback

# ---------------------------------------------------------------------------
# TradingView webhook
# Webhook URL: http://<host>:<port>/webhook/tradingview
# NOTE: TradingView does not allow request bodies/headers other than what the
# alert defines, so the secret travels in the JSON payload as "secret".
# ---------------------------------------------------------------------------
WEBHOOK_SECRET=change-me
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=9000
# Shown as the browser tab title and the dashboard header.
BOT_NAME=Belaku
WEBHOOK_PATH=/webhook/tradingview
WEBHOOK_BASE_URL=               # e.g. http://127.0.0.1:8000 (leave blank = auto)

# ---------------------------------------------------------------------------
# Sizing / risk
# ---------------------------------------------------------------------------
DEFAULT_LOTS=1
NIFTY_LOT_SIZE=65
VIRTUAL_BALANCE=200000
MAX_OPEN_LOTS=4
LOT_MARGIN=150000
SLIPPAGE_TICKS=1
TICK_SIZE=0.05
PRODUCT=NRML                    # NRML (carry-forward) | MIS (intraday)
ORDER_TYPE=MARKET

# ---------------------------------------------------------------------------
# Strategy gate (st.pine)
# The bot recomputes the Pine entry conditions on local candles and refuses a
# BUY/SELL webhook that contradicts them. FLAT/PANIC always bypass the gate.
# Defaults below mirror the inputs in st.pine - change only if you change Pine.
# ---------------------------------------------------------------------------
STRATEGY_GATE_ENABLED=true
STRATEGY_CANDLE_INTERVAL=5minute   # must match the TradingView chart interval
STRATEGY_CANDLE_LOOKBACK=400       # candles fetched/kept per symbol
STRATEGY_EMA_LENGTH=200
# Triple SuperTrend as atr_length:multiplier pairs, comma separated.
# Each pair is one vote; STRATEGY_ST_MIN_AGREE of them must agree.
STRATEGY_SUPERTRENDS=11:1,12:2,13:3
STRATEGY_ST_MIN_AGREE=2            # of the 3 SuperTrends that must agree
STRATEGY_PSAR_START=0.02
STRATEGY_PSAR_INCREMENT=0.02
STRATEGY_PSAR_MAXIMUM=0.2
# Fail-open escape hatch: execute even when no candles are available.
# Leave false - with it false the gate fails closed and rejects the entry.
STRATEGY_ALLOW_UNVERIFIED=false

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
DB_PATH=paper_trading.db
QUOTE_POLL_SECONDS=5
HTTP_TIMEOUT_SECONDS=4
